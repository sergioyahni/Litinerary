# Local-only live LLM smoke-test template.
# Copy to .env.development.local before use.
# The copied .env.development.local file is ignored by Git. Do not commit real secrets.
#
# This template is for controlled non-production LLM smoke testing only.
# It does not approve public, beta, staging, internal, or production live traffic.

APP_ENV=development
DEBUG=true
ENABLE_ADMIN_ROUTES=true
ENABLE_DEBUG_ROUTES=true
ENABLE_MOCK_SERVICES=true

# Required live LLM gates.
ENABLE_REAL_LLM=true
ALLOW_EXTERNAL_CALLS=true
ENABLE_STAGED_INTERNAL_LLM_TESTING=false
ENABLE_INTERNAL_ACCESS_GATE=false
EXTERNAL_CALL_ALLOWED_ENVIRONMENTS=development
LITINERARY_AI_PROVIDER=openai_compatible
LLM_PROVIDER=openai_compatible
LLM_API_KEY=<set locally from approved secret storage>
LLM_MODEL_NAME=<approved non-production model name>
LLM_ALLOWED_ENVIRONMENTS=development
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1200
# Set to max_completion_tokens for GPT-5-family Chat Completions models.
LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
LLM_MAX_RETRIES=0
LLM_MAX_LIVE_CALLS_PER_REQUEST=4
LLM_DAILY_LIVE_REQUEST_CEILING=4
LLM_DAILY_ESTIMATED_SPEND_CEILING_USD=0
LLM_LATENCY_ALERT_THRESHOLD_MS=5000
LLM_ERROR_RATE_ALERT_THRESHOLD_PERCENT=10
ITINERARY_GENERATION_MAX_DAYS=7

# Other live providers must remain disabled for this smoke test.
ENABLE_REAL_VECTOR_DB=false
ENABLE_REAL_POI_PROVIDER=false
ENABLE_REAL_ROUTING=false
ENABLE_REAL_TICKETING=false
ENABLE_AFFILIATE_LINKS=false
ENABLE_REAL_TTS=false
ENABLE_AUTH=false
AUTH_PROVIDER=dev

# Keep local/mock providers selected.
LITINERARY_VECTOR_PROVIDER=fake
VECTOR_DB_PROVIDER=fake
LITINERARY_POI_VERIFICATION_PROVIDER=mock
POI_PROVIDER=mock
ROUTING_PROVIDER=mock
TICKETING_PROVIDER=mock
AFFILIATE_PROVIDER=mock
TTS_PROVIDER=mock
