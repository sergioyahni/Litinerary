# Litinerary frontend staging configuration.
# Placeholder-only; do not commit real secrets.
# Must exactly match the staging backend API origin.
# Example only; replace in the deployed environment, not in source control.

VITE_API_BASE_URL=https://api.staging.litinerary.example
VITE_ENABLE_AUTH=true
VITE_AUTH_PROVIDER=auth0
VITE_AUTH_ALLOW_DEV_LOGIN=false
VITE_AUTH0_DOMAIN=<auth0-staging-domain>
VITE_AUTH0_CLIENT_ID=<auth0-staging-spa-client-id>
VITE_AUTH0_AUDIENCE=<auth0-staging-api-audience>
VITE_AUTH0_CALLBACK_URL=https://staging.litinerary.example/auth/callback
VITE_AUTH0_LOGOUT_RETURN_URL=https://staging.litinerary.example
VITE_AUTH0_USE_REFRESH_TOKENS=false
VITE_AUTH0_CACHE_LOCATION=memory
