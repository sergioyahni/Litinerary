# Litinerary frontend beta/staging configuration.
# Placeholder-only; do not commit real secrets.
# Must exactly match the private beta backend API origin.
# Example only; replace in the deployed environment, not in source control.

VITE_API_BASE_URL=https://api.beta.litinerary.example
VITE_ENABLE_AUTH=true
VITE_AUTH_PROVIDER=<managed-auth-provider-label>
VITE_AUTH_ALLOW_DEV_LOGIN=false
