# Litinerary frontend production configuration template.
# Placeholder-only; do not commit real secrets.

VITE_API_BASE_URL=https://api.litinerary.example
VITE_ENABLE_AUTH=true
VITE_AUTH_PROVIDER=auth0
VITE_AUTH_ALLOW_DEV_LOGIN=false
VITE_AUTH0_DOMAIN=<auth0-production-domain>
VITE_AUTH0_CLIENT_ID=<auth0-production-spa-client-id>
VITE_AUTH0_AUDIENCE=<auth0-production-api-audience>
VITE_AUTH0_CALLBACK_URL=https://app.litinerary.example/auth/callback
VITE_AUTH0_LOGOUT_RETURN_URL=https://app.litinerary.example
VITE_AUTH0_USE_REFRESH_TOKENS=false
VITE_AUTH0_CACHE_LOCATION=memory
