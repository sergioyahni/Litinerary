# Litinerary local development configuration.
# Copy values into your shell or a local .env loader if you add one.
# Do not commit real secrets.

APP_ENV=development
DEBUG=true
ENABLE_ADMIN_ROUTES=true
ENABLE_DEBUG_ROUTES=true
ENABLE_MOCK_SERVICES=true
ENABLE_REAL_LLM=false
ENABLE_REAL_VECTOR_DB=false
ENABLE_REAL_POI_PROVIDER=false
ENABLE_REAL_ROUTING=false
ENABLE_REAL_TICKETING=false
ENABLE_REAL_TTS=false
ENABLE_AFFILIATE_LINKS=false
ALLOW_EXTERNAL_CALLS=false
ENABLE_INTEGRATION_TESTS=false
ENABLE_STAGED_INTERNAL_LLM_TESTING=false
ENABLE_INTERNAL_ACCESS_GATE=false
# Production is the only environment allowed to make external calls by default.
# Add development or test only for explicit, intentional integration testing.
EXTERNAL_CALL_ALLOWED_ENVIRONMENTS=production
ENABLE_AUTH=false
AUTH_PROVIDER=dev
# Development uses disabled auth by default. If testing auth locally, use
# AUTH_PROVIDER=dev and explicit dev: bearer tokens only outside deployed envs.
# Deployed envs require ENABLE_AUTH=true, a managed provider label, issuer,
# audience, production algorithms, JWKS or provider metadata, ALLOW_EXTERNAL_CALLS=true,
# and the current APP_ENV in EXTERNAL_CALL_ALLOWED_ENVIRONMENTS.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=dev
AUTH_JWKS_URL=
AUTH_PROVIDER_METADATA_URL=
AUTH_USER_ID_CLAIM=sub
AUTH_ROLES_CLAIM=roles
AUTH_SUBSCRIPTION_CLAIM=subscription_status
AUTH_EMAIL_CLAIM=email
AUTH_DISPLAY_NAME_CLAIM=name
AUTH_REQUIRED_FOR_USER_FEATURES=false
AUTH_ALLOW_DEV_USER_FALLBACK=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LITINERARY_DATABASE_URL=sqlite:///./litinerary.db

# Current local providers are fake/mock only. These placeholders are for future adapters.
LITINERARY_AI_PROVIDER=fake
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1200
# Use max_completion_tokens for GPT-5-family Chat Completions models.
LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=0
LLM_MONTHLY_BUDGET_USD=
LLM_MAX_LIVE_CALLS_PER_REQUEST=4
LLM_DAILY_LIVE_REQUEST_CEILING=4
LLM_DAILY_ESTIMATED_SPEND_CEILING_USD=0
LLM_LATENCY_ALERT_THRESHOLD_MS=5000
LLM_ERROR_RATE_ALERT_THRESHOLD_PERCENT=10
# Real LLM calls require APP_ENV in both LLM_ALLOWED_ENVIRONMENTS and
# EXTERNAL_CALL_ALLOWED_ENVIRONMENTS, plus ENABLE_REAL_LLM=true,
# ALLOW_EXTERNAL_CALLS=true, provider=openai_compatible, LLM_API_KEY, and
# LLM_MODEL_NAME. Keep this mock by default.
LLM_ALLOWED_ENVIRONMENTS=development,production

LITINERARY_VECTOR_PROVIDER=fake
VECTOR_DB_PROVIDER=fake
VECTOR_DB_API_KEY=
LITINERARY_VECTOR_DIMENSION=16
LITINERARY_VECTOR_STORE_PATH=
# Qdrant is the first real Vector DB adapter target. Keep disabled unless intentionally testing it.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=litinerary
QDRANT_TIMEOUT_SECONDS=5

LITINERARY_POI_VERIFICATION_PROVIDER=mock
POI_VERIFICATION_PROVIDER=mock
# Alias accepted by the real POI adapter selector. Keep mock unless intentionally enabling Google Places.
POI_PROVIDER=mock
POI_VERIFICATION_API_KEY=
POI_PROVIDER_API_KEY=
GOOGLE_PLACES_API_KEY=
POI_PROVIDER_BASE_URL=https://places.googleapis.com
POI_PROVIDER_TIMEOUT_SECONDS=5
POI_PROVIDER_RESULT_LIMIT=5
POI_PROVIDER_MIN_CONFIDENCE=0.82
POI_PROVIDER_REGION_CODE=
POI_PROVIDER_LANGUAGE_CODE=

ROUTING_PROVIDER=mock
ROUTING_API_KEY=
OPENROUTESERVICE_API_KEY=
ROUTING_BASE_URL=https://api.openrouteservice.org
ROUTING_TIMEOUT_SECONDS=5
ROUTING_MAX_STOPS=10
# OpenRouteService boundary supports walking and car/taxi by default; public transit falls back or errors.
ROUTING_SUPPORTED_MODES=walking,car_taxi
ROUTING_FALLBACK_BEHAVIOR=mock

TICKETING_PROVIDER=mock
TICKETING_API_KEY=
TICKETING_BASE_URL=https://example.test
TICKETING_TIMEOUT_SECONDS=5

AFFILIATE_PROVIDER=mock
AFFILIATE_API_KEY=
AFFILIATE_BASE_URL=https://example.test/books
AFFILIATE_TIMEOUT_SECONDS=5

TTS_PROVIDER=mock
TTS_API_KEY=
TEXT_TO_SPEECH_API_KEY=
TTS_BASE_URL=https://example.test/tts
TTS_TIMEOUT_SECONDS=5

# Local/mock usage guardrails. Development may use the local fallback store;
# deployed environments must set ENABLE_DURABLE_USAGE_CONTROLS=true.
ENABLE_DURABLE_USAGE_CONTROLS=false
ANONYMOUS_ITINERARY_GENERATIONS_PER_MINUTE=10
ANONYMOUS_ITINERARY_GENERATIONS_PER_DAY=100
REGISTERED_USER_ITINERARY_GENERATIONS_PER_MINUTE=30
REGISTERED_USER_ITINERARY_GENERATIONS_PER_DAY=250
SUBSCRIBER_CHAT_MESSAGES_PER_MINUTE=60
SUBSCRIBER_CHAT_MESSAGES_PER_DAY=250
VECTOR_SEARCH_MAX_RESULTS=20
POI_VERIFICATION_MAX_BATCH_SIZE=25
TICKETING_LOOKUP_MAX_REQUESTS_PER_ITINERARY=10
ITINERARY_GENERATION_MAX_DAYS=7
PROVIDER_DAILY_REQUEST_CEILING=1000
# Default 0 means any future positive-cost operation must opt into a ceiling.
PROVIDER_DAILY_COST_CEILING_USD=0
USAGE_COUNTER_RETENTION_DAYS=90
