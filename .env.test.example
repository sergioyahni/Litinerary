# Litinerary standard test configuration.
# Placeholder-only; do not commit real secrets.

APP_ENV=test
DEBUG=false
ENABLE_ADMIN_ROUTES=true
ENABLE_DEBUG_ROUTES=true
ENABLE_MOCK_SERVICES=true
ENABLE_REAL_LLM=false
ENABLE_REAL_VECTOR_DB=false
ENABLE_REAL_POI_PROVIDER=false
ENABLE_REAL_ROUTING=false
ENABLE_REAL_TICKETING=false
ENABLE_REAL_TTS=false
ENABLE_AFFILIATE_LINKS=false
ALLOW_EXTERNAL_CALLS=false
ENABLE_INTEGRATION_TESTS=false
ENABLE_STAGED_INTERNAL_LLM_TESTING=false
ENABLE_INTERNAL_ACCESS_GATE=false
EXTERNAL_CALL_ALLOWED_ENVIRONMENTS=production
ENABLE_AUTH=false
AUTH_PROVIDER=dev
# Managed auth provider lookups are blocked during standard APP_ENV=test runs.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ALGORITHMS=dev
AUTH_REQUIRED_FOR_USER_FEATURES=false
AUTH_ALLOW_DEV_USER_FALLBACK=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LITINERARY_DATABASE_URL=sqlite:///./litinerary-test.db

LITINERARY_AI_PROVIDER=fake
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1200
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=0
LLM_MONTHLY_BUDGET_USD=
LLM_MAX_LIVE_CALLS_PER_REQUEST=4
LLM_DAILY_LIVE_REQUEST_CEILING=4
LLM_DAILY_ESTIMATED_SPEND_CEILING_USD=0
LLM_LATENCY_ALERT_THRESHOLD_MS=5000
LLM_ERROR_RATE_ALERT_THRESHOLD_PERCENT=10
# Standard tests must stay offline. Add test here and to
# EXTERNAL_CALL_ALLOWED_ENVIRONMENTS only for an explicit live integration run.
LLM_ALLOWED_ENVIRONMENTS=development,production

LITINERARY_VECTOR_PROVIDER=fake
VECTOR_DB_PROVIDER=fake
VECTOR_DB_API_KEY=
LITINERARY_VECTOR_DIMENSION=16
LITINERARY_VECTOR_STORE_PATH=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=litinerary
QDRANT_TIMEOUT_SECONDS=5

LITINERARY_POI_VERIFICATION_PROVIDER=mock
POI_VERIFICATION_PROVIDER=mock
POI_PROVIDER=mock
POI_VERIFICATION_API_KEY=
POI_PROVIDER_API_KEY=
GOOGLE_PLACES_API_KEY=
POI_PROVIDER_BASE_URL=https://places.googleapis.com
POI_PROVIDER_TIMEOUT_SECONDS=5
POI_PROVIDER_RESULT_LIMIT=5
POI_PROVIDER_MIN_CONFIDENCE=0.82

ROUTING_PROVIDER=mock
ROUTING_API_KEY=
OPENROUTESERVICE_API_KEY=
ROUTING_BASE_URL=https://api.openrouteservice.org
ROUTING_TIMEOUT_SECONDS=5
ROUTING_MAX_STOPS=10
ROUTING_SUPPORTED_MODES=walking,car_taxi
ROUTING_FALLBACK_BEHAVIOR=mock

TICKETING_PROVIDER=mock
TICKETING_API_KEY=
TICKETING_BASE_URL=https://example.test
TICKETING_TIMEOUT_SECONDS=5

AFFILIATE_PROVIDER=mock
AFFILIATE_API_KEY=
AFFILIATE_BASE_URL=https://example.test/books
AFFILIATE_TIMEOUT_SECONDS=5

TTS_PROVIDER=mock
TTS_API_KEY=
TEXT_TO_SPEECH_API_KEY=
TTS_BASE_URL=https://example.test/tts
TTS_TIMEOUT_SECONDS=5

ANONYMOUS_ITINERARY_GENERATIONS_PER_DAY=100
REGISTERED_USER_ITINERARY_GENERATIONS_PER_DAY=250
SUBSCRIBER_CHAT_MESSAGES_PER_DAY=250
VECTOR_SEARCH_MAX_RESULTS=20
POI_VERIFICATION_MAX_BATCH_SIZE=25
TICKETING_LOOKUP_MAX_REQUESTS_PER_ITINERARY=10
ITINERARY_GENERATION_MAX_DAYS=7
PROVIDER_DAILY_COST_CEILING_USD=0
